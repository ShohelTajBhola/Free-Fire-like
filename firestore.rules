rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /admins/{adminId} {
      allow read, write: if true;
    }
    match /settings/{settingId} {
      allow read, write: if true;
    }
    match /shortLinks/{linkId} {
      allow read, write: if true;
    }
    match /verifications/{verId} {
      allow read, write: if true;
    }
    match /likesRequests/{reqId} {
      allow read, write: if true;
    }
    match /apiLogs/{logId} {
      allow read, write: if true;
    }
  }
}
